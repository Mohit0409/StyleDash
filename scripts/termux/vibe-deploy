#!/data/data/com.termux/files/usr/bin/bash
# Owner-safe detached entry point for Vibe4You deployment transactions.
set -euo pipefail
umask 077

HOME_ROOT="${STYLEDASH_DEPLOY_HOME:-$HOME}"
DEPLOY_ROOT="$HOME_ROOT/.local/share/styledash/deployments"
RUN_DIR="$HOME_ROOT/run"
LOG_DIR="$HOME_ROOT/logs"
LOCK_DIR="$RUN_DIR/vibe-deploy.lock"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
PYTHON_RUNNER="$SCRIPT_DIR/vibe_deploy.py"

usage() {
  echo "usage: vibe-deploy --preflight-only ARTIFACT | --deploy ARTIFACT | --resume ARTIFACT | --status" >&2
  exit 2
}

[ -f "$PYTHON_RUNNER" ] || {
  echo "vibe-deploy Python runner is missing" >&2
  exit 1
}

mkdir -p "$DEPLOY_ROOT" "$RUN_DIR" "$LOG_DIR"
chmod 700 "$DEPLOY_ROOT" "$RUN_DIR" "$LOG_DIR"

if [ "${1:-}" = "--status" ] && [ "$#" -eq 1 ]; then
  exec python3 "$PYTHON_RUNNER" --status
fi

mode="${1:-}"
artifact="${2:-}"
[ "$#" -eq 2 ] || usage
[ -f "$artifact" ] && [ -f "$artifact.sha256" ] || {
  echo "artifact or checksum is missing: $artifact" >&2
  exit 1
}

case "$mode" in
  --preflight-only)
    exec python3 "$PYTHON_RUNNER" --preflight-only "$artifact"
    ;;
  --deploy|--resume) ;;
  *) usage ;;
esac

# Lock before preflight: an overlapping invocation must not even recreate the
# deterministic staging directory while the owner transaction is active.
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
  case "$lock_pid" in
    ''|*[!0-9]*) lock_pid='' ;;
  esac
  if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
    echo "EXISTING_TRANSACTION=YES"
    python3 "$PYTHON_RUNNER" --status
    exit 0
  fi
  rm -f -- "$LOCK_DIR/pid"
  rmdir -- "$LOCK_DIR" 2>/dev/null || {
    echo "stale deployment lock could not be removed safely" >&2
    exit 75
  }
  mkdir "$LOCK_DIR"
fi
lock_transferred=0
cleanup_launcher_lock() {
  # A child may have atomically claimed this lock just before the foreground
  # shell receives HUP. Never remove a lock whose PID is no longer ours.
  if [ "$lock_transferred" -eq 0 ] && [ "$(cat "$LOCK_DIR/pid" 2>/dev/null || true)" = "$$" ]; then
    rm -f -- "$LOCK_DIR/pid" "$LOCK_DIR/ready"
    rmdir -- "$LOCK_DIR" 2>/dev/null || true
  fi
}
trap cleanup_launcher_lock EXIT INT TERM HUP
printf '%s\n' "$$" > "$LOCK_DIR/pid"
chmod 600 "$LOCK_DIR/pid"

# Run the complete non-mutating preflight in the operator's foreground. This
# guarantees an immediate, concise refusal before any backup is detached.
python3 "$PYTHON_RUNNER" --preflight-only "$artifact"

log="$LOG_DIR/vibe-deploy-launcher-$(date -u +%Y%m%dT%H%M%SZ).log"
detached_body='set -u
runner="$1"
artifact="$2"
lock="$3"
parent_pid="$4"
cleanup() { rm -f -- "$lock/pid" "$lock/ready"; rmdir -- "$lock" 2>/dev/null || true; }
trap cleanup EXIT INT TERM HUP
# Never claim a lock after the foreground launcher disappeared. This prevents a
# stale-lock cleanup from handing the same directory to two transactions.
[ -d "$lock" ] && [ "$(cat "$lock/pid" 2>/dev/null || true)" = "$parent_pid" ] && kill -0 "$parent_pid" 2>/dev/null || exit 75
printf "%s\n" "$$" > "$lock/.pid.$$"
mv -f -- "$lock/.pid.$$" "$lock/pid"
chmod 600 "$lock/pid"
printf "%s\n" "$$" > "$lock/ready"
chmod 600 "$lock/ready"
python3 "$runner" --run "$artifact" --resume'

# setsid + nohup disconnect stdin/stdout/stderr and the controlling session.
# The server-side process therefore survives a Windows SSH/network drop.
if command -v setsid >/dev/null 2>&1; then
  nohup setsid bash -c "$detached_body" vibe-deploy-detached "$PYTHON_RUNNER" "$artifact" "$LOCK_DIR" "$$" </dev/null >>"$log" 2>&1 &
else
  nohup bash -c "$detached_body" vibe-deploy-detached "$PYTHON_RUNNER" "$artifact" "$LOCK_DIR" "$$" </dev/null >>"$log" 2>&1 &
fi
launcher_pid=$!
chmod 600 "$log" 2>/dev/null || true
child_ready=0
for _ in $(seq 1 50); do
  child_pid="$(cat "$LOCK_DIR/ready" 2>/dev/null || true)"
  case "$child_pid" in ''|*[!0-9]*) child_pid='' ;; esac
  if [ -n "$child_pid" ] && [ "$(cat "$LOCK_DIR/pid" 2>/dev/null || true)" = "$child_pid" ] && kill -0 "$child_pid" 2>/dev/null; then
    child_ready=1
    break
  fi
  sleep 0.1
done
[ "$child_ready" -eq 1 ] || { echo "detached deployment runner did not acknowledge its lock" >&2; exit 1; }
lock_transferred=1
trap - EXIT INT TERM HUP
echo "DETACHED=YES"
echo "SERVER_JOB_PID=$launcher_pid"
echo "STATUS_COMMAND=vibe-deploy --status"
echo "LOG=$log"
