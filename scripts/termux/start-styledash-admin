#!/data/data/com.termux/files/usr/bin/bash
# Starts exactly one loopback-only StyleDash administrator server.
set -eu

APP_DIR="$HOME/admin"
RUN_DIR="$HOME/run"
LOG_DIR="$HOME/logs"
SECRET_FILE="$HOME/.config/styledash/secrets.env"
DATA_ROOT="$HOME/.local/share/styledash"
PID_FILE="$RUN_DIR/styledash-admin.pid"
LOG_FILE="$LOG_DIR/styledash-admin.log"
PROCESS_LIB="$HOME/bin/styledash-process-lib"
LOCK_DIR="$RUN_DIR/styledash-admin-start.lock"
ADMIN_MARKER="$APP_DIR/serve.py --bind 127.0.0.1 --port 8081"
ADMIN_IDENTITY="--assets $APP_DIR/admin"

mkdir -p "$RUN_DIR" "$LOG_DIR" "$DATA_ROOT/runtime"
chmod 700 "$DATA_ROOT" "$DATA_ROOT/runtime" "$APP_DIR"
[ -r "$PROCESS_LIB" ] || {
  echo "StyleDash process control library is missing" >&2
  exit 1
}
# shellcheck disable=SC1090 -- installed alongside this launcher.
. "$PROCESS_LIB"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
  case "$lock_pid" in
    ''|*[!0-9]*) lock_pid='' ;;
  esac
  if [ -z "$lock_pid" ] || ! kill -0 "$lock_pid" 2>/dev/null; then
    rm -rf -- "$LOCK_DIR"
    mkdir "$LOCK_DIR"
  else
    echo "StyleDash administrator startup is already in progress" >&2
    exit 1
  fi
fi
printf '%s\n' "$$" > "$LOCK_DIR/pid"
cleanup() { rm -rf -- "$LOCK_DIR"; }
trap cleanup EXIT INT TERM

if [ ! -f "$SECRET_FILE" ]; then
  echo "$(date -Iseconds) private environment missing; admin service refused" >> "$LOG_FILE"
  exit 1
fi
chmod 600 "$SECRET_FILE"
set -a
# shellcheck disable=SC1090
. "$SECRET_FILE"
set +a
if [ -z "${STYLEDASH_TOTP_ENCRYPTION_KEY:-}" ]; then
  echo "$(date -Iseconds) TOTP encryption key missing; admin service refused" >> "$LOG_FILE"
  exit 1
fi

export STYLEDASH_CATALOG_PATH="$DATA_ROOT/catalog.json"
export STYLEDASH_SETTINGS_PATH="$DATA_ROOT/settings.json"
export STYLEDASH_DATA_DIR="$DATA_ROOT/runtime"
export STYLEDASH_DATABASE_PATH="$DATA_ROOT/styledash.db"

healthy_for_pid() {
  expected_pid="$1"
  headers_file="$(mktemp "$RUN_DIR/styledash-admin-health.XXXXXX")"
  if ! curl -fsS --max-time 3 -D "$headers_file" -o /dev/null \
    -H 'Host: 127.0.0.1:8081' http://127.0.0.1:8081/; then
    rm -f -- "$headers_file"
    return 1
  fi
  serving_pid="$(awk -F ': *' 'tolower($1)=="x-styledash-process-id" {gsub("\\r", "", $2); print $2}' "$headers_file" | tail -n 1)"
  rm -f -- "$headers_file"
  [ "$serving_pid" = "$expected_pid" ]
}

managed_pid="$(styledash_read_pid_file "$PID_FILE" 2>/dev/null || true)"
if [ -n "$managed_pid" ] && \
   styledash_assert_single_process "$managed_pid" "$ADMIN_MARKER" "$ADMIN_IDENTITY" && \
   healthy_for_pid "$managed_pid"; then
  printf '%s\n' "$managed_pid" > "$PID_FILE"
  chmod 600 "$PID_FILE"
  printf 'styledash_admin_pid=%s\n' "$managed_pid"
  exit 0
fi

styledash_stop_matching_processes "StyleDash administrator service" "$ADMIN_MARKER" "$ADMIN_IDENTITY"
rm -f -- "$PID_FILE"
styledash_wait_for_port_release 8081 "StyleDash administrator service"

[ -f "$LOG_FILE" ] && [ "$(wc -l < "$LOG_FILE")" -gt 1500 ] && tail -n 1000 "$LOG_FILE" > "$LOG_FILE.trim" && mv "$LOG_FILE.trim" "$LOG_FILE"
nohup python3 "$APP_DIR/serve.py" --bind 127.0.0.1 --port 8081 --assets "$APP_DIR/admin" >> "$LOG_FILE" 2>&1 &
pid="$!"
printf '%s\n' "$pid" > "$PID_FILE"
chmod 600 "$PID_FILE"
for _ in $(seq 1 12); do
  if kill -0 "$pid" 2>/dev/null && \
     styledash_assert_single_process "$pid" "$ADMIN_MARKER" "$ADMIN_IDENTITY" && \
     healthy_for_pid "$pid"; then
    [ "$(styledash_read_pid_file "$PID_FILE")" = "$pid" ] || break
    printf 'styledash_admin_pid=%s\n' "$pid"
    printf 'styledash_admin_process_count=1\n'
    exit 0
  fi
  sleep 1
done
styledash_stop_matching_processes "StyleDash administrator service" "$ADMIN_MARKER" "$ADMIN_IDENTITY" || true
rm -f -- "$PID_FILE"
echo "$(date -Iseconds) local administrator service failed process identity validation" >> "$LOG_FILE"
exit 1
