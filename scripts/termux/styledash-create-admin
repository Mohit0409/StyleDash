#!/data/data/com.termux/files/usr/bin/bash
set -eu

SECRET_FILE="$HOME/.config/styledash/secrets.env"
if [ ! -f "$SECRET_FILE" ]; then
  echo "Vibe4You private environment is missing." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
. "$SECRET_FILE"
set +a
export STYLEDASH_DATABASE_PATH="$HOME/.local/share/styledash/styledash.db"
exec python3 "$HOME/admin/tools/create_admin.py"
