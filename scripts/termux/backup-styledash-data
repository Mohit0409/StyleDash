#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

LOCAL_ONLY=false
if [ "${1:-}" = "--local-only" ]; then
  LOCAL_ONLY=true
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "usage: backup-styledash-data [--local-only]" >&2
  exit 2
fi

DATA_ROOT="$HOME/.local/share/styledash"
BACKUP_ROOT="$DATA_ROOT/backups"
DB="$DATA_ROOT/styledash.db"
STATE="$DATA_ROOT/runtime/orders.json"
PRODUCT_IMAGES="$DATA_ROOT/product-images"
PRIVATE_CONFIG_DIR="$HOME/.config/styledash"
SECRETS_FILE="$PRIVATE_CONFIG_DIR/secrets.env"
RUN_DIR="$HOME/run"
LOCK_DIR="$RUN_DIR/styledash-backup.lock"

mkdir -p "$BACKUP_ROOT" "$RUN_DIR"
chmod 700 "$BACKUP_ROOT"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  echo "A Vibe4You backup is already running; refusing an overlapping run" >&2
  exit 75
fi
printf '%s\n' "$$" > "$LOCK_DIR/pid"
chmod 600 "$LOCK_DIR/pid"
release_lock() {
  rm -f -- "$LOCK_DIR/pid"
  rmdir -- "$LOCK_DIR" 2>/dev/null || true
}
trap release_lock EXIT
trap 'exit 143' HUP INT TERM

if [ -f "$SECRETS_FILE" ]; then
  set -a
  . "$SECRETS_FILE"
  set +a
fi

enabled() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

run_rclone() {
  if command -v ionice >/dev/null 2>&1; then
    nice -n 10 ionice -c 3 rclone "$@"
  else
    nice -n 10 rclone "$@"
  fi
}

verify_remote() {
  local source="$1"
  local destination="$2"
  local label="$3"
  local attempt=1
  while true; do
    if run_rclone check "$source" "$destination" --one-way --download --checkers 1 --contimeout 15s --timeout 60s --retries 2 --low-level-retries 2; then
      return 0
    fi
    if [ "$attempt" -ge 3 ]; then
      echo "$label verification failed after retries" >&2
      return 1
    fi
    attempt=$((attempt + 1))
    echo "$label verification retry $attempt/3" >&2
    sleep 10
  done
}

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
target="$BACKUP_ROOT/$stamp"
mkdir -p "$target"
chmod 700 "$target"

if [ -f "$DB" ]; then
  python3 - "$DB" "$target/styledash.db" <<'PY'
import sqlite3
import sys

source = sqlite3.connect(sys.argv[1])
target = sqlite3.connect(sys.argv[2])
try:
    source.backup(target)
finally:
    target.close()
    source.close()

check = sqlite3.connect(sys.argv[2])
try:
    integrity = check.execute("PRAGMA integrity_check").fetchone()[0]
finally:
    check.close()
if integrity != "ok":
    raise SystemExit("SQLite backup integrity check failed")
PY
  chmod 600 "$target/styledash.db"
fi

if [ -f "$STATE" ]; then
  cp -p "$STATE" "$target/orders.json"
  chmod 600 "$target/orders.json"
fi

if [ -d "$PRODUCT_IMAGES" ]; then
  mkdir -p "$target/product-images"
  cp -a "$PRODUCT_IMAGES/." "$target/product-images/"
  chmod 700 "$target/product-images"
fi

python3 - "$BACKUP_ROOT" <<'PY'
from pathlib import Path
import re
import shutil
import sys

root = Path(sys.argv[1]).resolve()
pattern = re.compile(r"^\d{8}T\d{6}Z$")
backups = sorted(
    (
        path
        for path in root.iterdir()
        if path.is_dir() and pattern.fullmatch(path.name)
    ),
    reverse=True,
)
for path in backups[14:]:
    resolved = path.resolve()
    if resolved.parent != root:
        raise SystemExit("Refusing unsafe backup retention target")
    shutil.rmtree(resolved)
PY

printf '%s\n' "$stamp" > "$RUN_DIR/styledash-last-local-backup"
chmod 600 "$RUN_DIR/styledash-last-local-backup"

if [ "$LOCAL_ONLY" = false ]; then
  remote="${STYLEDASH_BACKUP_REMOTE:-}"
  require_remote="${STYLEDASH_REQUIRE_OFFDEVICE_BACKUP:-false}"

  if [ -n "$remote" ]; then
    case "$remote" in
      *:*) ;;
      *)
        echo "STYLEDASH_BACKUP_REMOTE must be an rclone remote:path" >&2
        exit 1
        ;;
    esac
    if ! command -v rclone >/dev/null 2>&1; then
      echo "rclone is required for configured off-device backups" >&2
      exit 1
    fi

    remote_target="${remote%/}/$stamp"
    run_rclone copy "$target" "$remote_target" \
      --immutable \
      --create-empty-src-dirs \
      --transfers 1 --checkers 1 --contimeout 15s --timeout 60s --retries 2 --low-level-retries 2
    verify_remote "$target" "$remote_target" "Primary off-device backup"

    printf '%s\n' "$stamp" > "$RUN_DIR/styledash-last-offdevice-backup"
    chmod 600 "$RUN_DIR/styledash-last-offdevice-backup"
    echo "Primary off-device Vibe4You backup verified: $stamp"

    secondary="${STYLEDASH_BACKUP_REMOTE_SECONDARY:-}"
    if [ -n "$secondary" ]; then
      secondary_target="${secondary%/}/$stamp"

      # The Windows/SFTP secondary can normalize mtimes even when file bytes are
      # unchanged. Compare content rather than timestamps for the immutable copy;
      # verify_remote still performs a full --download byte check afterwards.
      run_rclone copy "$target" "$secondary_target" --immutable --checksum --create-empty-src-dirs --transfers 1 --checkers 1 --contimeout 15s --timeout 60s --retries 2 --low-level-retries 2
      verify_remote "$target" "$secondary_target" "Secondary off-device backup"

      printf '%s\n' "$stamp" > "$RUN_DIR/styledash-last-secondary-backup"
      chmod 600 "$RUN_DIR/styledash-last-secondary-backup"
      echo "Secondary off-device Vibe4You backup verified: $stamp"
    fi
  elif enabled "$require_remote"; then
    echo "Off-device backup is required but STYLEDASH_BACKUP_REMOTE is not configured" >&2
    exit 1
  fi
fi

echo "Private Vibe4You backup completed: $stamp"
