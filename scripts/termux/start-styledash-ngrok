#!/data/data/com.termux/files/usr/bin/bash
# Starts exactly one authenticated ngrok endpoint for StyleDash.
set -u

RUN_DIR="$HOME/run"
LOG_DIR="$HOME/logs"
PID_FILE="$RUN_DIR/styledash-ngrok.pid"
URL_FILE="$RUN_DIR/styledash-public-url"
LOG_FILE="$LOG_DIR/styledash-ngrok.log"
NGROK_CONFIGS="$HOME/.config/ngrok/ngrok.yml,$HOME/.config/ngrok/styledash.yml"
EXPECTED_CMD='ngrok http http://127.0.0.1:8080'

mkdir -p "$RUN_DIR" "$LOG_DIR"

trim_log() {
  [ -f "$1" ] && [ "$(wc -l < "$1")" -gt 2000 ] && tail -n 1500 "$1" > "$1.trim" && mv "$1.trim" "$1"
}

healthy() {
  curl -fsS --max-time 5 http://127.0.0.1:8080/ >/dev/null
}

managed_pid() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null &&
    tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -Fq "$EXPECTED_CMD"
}

agent_url() {
  curl -fsS --max-time 3 http://127.0.0.1:4040/api/tunnels 2>/dev/null |
    python3 -c 'import json,sys; d=json.load(sys.stdin); print(next((t.get("public_url", "") for t in d.get("tunnels", []) if t.get("public_url", "").startswith("https://")), ""))' 2>/dev/null
}

if ! healthy; then
  "$HOME/bin/start-styledash" || exit 1
fi

pid=''
if [ -s "$PID_FILE" ]; then
  pid="$(cat "$PID_FILE")"
  managed_pid "$pid" || pid=''
fi

if [ -z "$pid" ]; then
  matches="$(pgrep -f "$EXPECTED_CMD" 2>/dev/null || true)"
  if [ "$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l)" -eq 1 ]; then
    pid="$matches"
    printf '%s\n' "$pid" > "$PID_FILE"
  fi
fi

if managed_pid "$pid"; then
  for _ in $(seq 1 10); do
    url="$(agent_url || true)"
    if printf '%s' "$url" | grep -Eq '^https://[-a-z0-9]+\.ngrok-free\.(app|dev)$'; then
      printf '%s\n' "$url" > "$URL_FILE"
      exit 0
    fi
    sleep 1
  done
  echo "$(date -Iseconds) ngrok agent is running but has not established its endpoint yet" >> "$LOG_FILE"
  exit 1
fi

rm -f "$PID_FILE" "$URL_FILE"
trim_log "$LOG_FILE"
nohup ngrok http http://127.0.0.1:8080 \
  --config "$NGROK_CONFIGS" \
  --log stdout \
  --log-format json >> "$LOG_FILE" 2>&1 &
pid="$!"
printf '%s\n' "$pid" > "$PID_FILE"

for _ in $(seq 1 45); do
  url="$(agent_url || true)"
  if printf '%s' "$url" | grep -Eq '^https://[-a-z0-9]+\.ngrok-free\.(app|dev)$'; then
    printf '%s\n' "$url" > "$URL_FILE"
    exit 0
  fi
  kill -0 "$pid" 2>/dev/null || break
  sleep 1
done

echo "$(date -Iseconds) ngrok did not establish an endpoint within 45 seconds; it may reconnect in the background" >> "$LOG_FILE"
exit 1
