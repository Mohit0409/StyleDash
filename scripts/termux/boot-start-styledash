#!/data/data/com.termux/files/usr/bin/bash
# Run by the Termux:Boot Android companion application after phone startup.
set -u

LOG_DIR="$HOME/logs"
LOG_FILE="$LOG_DIR/styledash-boot.log"
mkdir -p "$LOG_DIR"
[ -f "$LOG_FILE" ] && [ "$(wc -l < "$LOG_FILE")" -gt 2000 ] && tail -n 1500 "$LOG_FILE" > "$LOG_FILE.trim" && mv "$LOG_FILE.trim" "$LOG_FILE"
exec >> "$LOG_FILE" 2>&1
echo "$(date -Iseconds) boot startup requested"

termux-wake-lock || true
source "$PREFIX/etc/profile.d/start-services.sh"

# start-services.sh launches runsvdir asynchronously. Wait for it before
# asking runit to bring sshd up, otherwise early boot races with runsv.
SSHD_READY=0
for _ in $(seq 1 20); do
  if sv status sshd >/dev/null 2>&1; then
    SSHD_READY=1
    break
  fi
  sleep 1
done
if [ "$SSHD_READY" -eq 1 ] && sv up sshd; then
  echo "$(date -Iseconds) sshd service ready"
else
  echo "$(date -Iseconds) sshd service failed to become ready" >&2
fi

for _ in $(seq 1 30); do
  curl -fsS --max-time 3 http://127.0.0.1:8080/api/health >/dev/null && break
  "$HOME/bin/start-styledash" || true
  sleep 1
done

"$HOME/bin/start-styledash-stack" || echo "$(date -Iseconds) stack start failed"
echo "$(date -Iseconds) boot startup finished"
