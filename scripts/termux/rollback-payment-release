#!/data/data/com.termux/files/usr/bin/bash
# Restore a pre-release code/config snapshot without restoring historical customer/payment data.
set -eu

RUN_DIR="$HOME/run"
BACKUP_ROOT="$HOME/backups"
POINTER="$RUN_DIR/styledash-last-release-backup"
DATA_ROOT="$HOME/.local/share/styledash"
LOG_FILE="$HOME/logs/styledash-rollback.log"

mkdir -p "$RUN_DIR" "$BACKUP_ROOT" "$HOME/logs"

notify() {
  if [ -x "$HOME/bin/styledash-notify" ]; then
    "$HOME/bin/styledash-notify" "$@" >/dev/null 2>&1 || true
  fi
}

fail() {
  code=$?
  set +e
  echo "$(date -Iseconds) rollback failed; manual recovery required" >> "$LOG_FILE"
  notify rollback_failed "Vibe4You rollback failed" "Code rollback failed and requires manual recovery." 5 rotating_light
  exit "$code"
}
trap fail ERR

if [ "$#" -gt 1 ]; then
  echo "usage: rollback-payment-release [PRE_RELEASE_BACKUP]" >&2
  exit 2
fi

if [ "$#" -eq 1 ]; then
  requested="$1"
else
  if [ ! -s "$POINTER" ]; then
    echo "No recorded pre-release backup is available" >&2
    exit 1
  fi
  requested="$(cat "$POINTER")"
fi

backup="$(realpath -e "$requested")"
case "$backup" in
  "$BACKUP_ROOT"/styledash-pre-payment.*) ;;
  *)
    echo "Refusing rollback path outside the managed pre-release backup root" >&2
    exit 1
    ;;
esac

for required in server bin boot/start-styledash; do
  if [ ! -e "$backup/$required" ]; then
    echo "Rollback snapshot is missing $required" >&2
    exit 1
  fi
done

# Preserve current authoritative production data before changing executable code.
"$HOME/bin/backup-styledash-data" --local-only

recovery="$(mktemp -d "$BACKUP_ROOT/styledash-pre-rollback.XXXXXX")"
cp -a "$HOME/server" "$recovery/server"
if [ -d "$HOME/admin" ]; then
  cp -a "$HOME/admin" "$recovery/admin"
fi
mkdir -p "$recovery/bin" "$recovery/boot" "$recovery/data"
cp -a "$HOME/bin/." "$recovery/bin/"
if [ -f "$HOME/.termux/boot/start-styledash" ]; then
  cp -a "$HOME/.termux/boot/start-styledash" "$recovery/boot/"
fi
for config in catalog.json settings.json; do
  if [ -f "$DATA_ROOT/$config" ]; then
    cp -a "$DATA_ROOT/$config" "$recovery/data/$config"
  fi
done
printf 'recovery_snapshot=%s\n' "$recovery"

if [ -s "$RUN_DIR/styledash-health.pid" ]; then
  health_pid="$(cat "$RUN_DIR/styledash-health.pid")"
  kill "$health_pid" 2>/dev/null || true
fi
if [ -x "$HOME/bin/stop-styledash-ngrok" ]; then
  "$HOME/bin/stop-styledash-ngrok" || true
fi

for service in styledash styledash-admin; do
  pid_file="$RUN_DIR/$service.pid"
  if [ -s "$pid_file" ]; then
    pid="$(cat "$pid_file")"
    kill "$pid" 2>/dev/null || true
  fi
done
sleep 1

rm -rf -- "$HOME/server"
cp -a "$backup/server" "$HOME/server"
if [ -d "$backup/admin" ]; then
  rm -rf -- "$HOME/admin"
  cp -a "$backup/admin" "$HOME/admin"
fi

for file in "$backup"/bin/*; do
  [ -f "$file" ] || continue
  install -m 755 "$file" "$HOME/bin/$(basename "$file")"
done
install -m 755 "$backup/boot/start-styledash" "$HOME/.termux/boot/start-styledash"

for config in catalog.json settings.json; do
  if [ -f "$backup/data/$config" ]; then
    install -m 644 "$backup/data/$config" "$DATA_ROOT/$config"
  fi
done

"$HOME/bin/start-styledash-stack"

curl -fsS --max-time 5 http://127.0.0.1:8080/api/health >/dev/null
curl -fsS --max-time 5 -H 'Host: 127.0.0.1:8081' http://127.0.0.1:8081/ >/dev/null

trap - ERR
echo "$(date -Iseconds) rollback completed from $backup" >> "$LOG_FILE"
notify rollback_completed "Vibe4You rollback completed" "The previous code/config release was restored. Live production data was preserved." 4 white_check_mark
printf 'rollback_restored=%s\n' "$backup"
printf 'production_data=preserved\n'
