#!/data/data/com.termux/files/usr/bin/bash
set -u

PID_FILE="$HOME/run/styledash-ngrok.pid"
URL_FILE="$HOME/run/styledash-public-url"
EXPECTED_CMD='ngrok http http://127.0.0.1:8080'

if [ -s "$PID_FILE" ]; then
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq "$EXPECTED_CMD"; then
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 10); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
  fi
fi

rm -f "$PID_FILE" "$URL_FILE"
