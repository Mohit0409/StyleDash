#!/data/data/com.termux/files/usr/bin/bash
# Migrate legacy Test API names to mode-specific names without printing values.
set -eu

SECRET_FILE="$HOME/.config/styledash/secrets.env"
TEMP_FILE="$HOME/.config/styledash/secrets.env.tmp"

python3 - "$SECRET_FILE" "$TEMP_FILE" <<'PY'
import re
import sys
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])
values = {}
preserved_lines = []

for raw_line in source.read_text(encoding="utf-8").splitlines():
    line = raw_line.strip()
    match = re.fullmatch(r"(?:export\s+)?(RAZORPAY_[A-Z_]+)\s*[:=]\s*(\S*)\s*", line)
    if match:
        values[match.group(1)] = match.group(2)
    elif line:
        preserved_lines.append(raw_line)

if values.get("RAZORPAY_WEBHOOK_SECRET"):
    raise SystemExit("Generic webhook secret is ambiguous; move it manually to the correct mode first.")
test_key_id = values.get("RAZORPAY_TEST_KEY_ID") or values.get("RAZORPAY_KEY_ID", "")
test_key_secret = values.get("RAZORPAY_TEST_KEY_SECRET") or values.get("RAZORPAY_KEY_SECRET", "")
if not test_key_id or not test_key_secret:
    raise SystemExit("Test API credentials are incomplete; no values were changed.")
if not test_key_id.startswith("rzp_test_"):
    raise SystemExit("The configured Key ID is not a Razorpay Test Mode key; no values were changed.")
if not re.fullmatch(r"[A-Za-z0-9_]+", test_key_id):
    raise SystemExit("The Test Key ID contains unexpected characters; no values were changed.")
if not re.fullmatch(r"[A-Za-z0-9]+", test_key_secret):
    raise SystemExit("The Key Secret contains unexpected characters; no values were changed.")

values.pop("RAZORPAY_KEY_ID", None)
values.pop("RAZORPAY_KEY_SECRET", None)
values.pop("RAZORPAY_WEBHOOK_SECRET", None)
values["RAZORPAY_MODE"] = "test"
values["RAZORPAY_TEST_KEY_ID"] = test_key_id
values["RAZORPAY_TEST_KEY_SECRET"] = test_key_secret
ordered = [
    "RAZORPAY_MODE", "RAZORPAY_TEST_KEY_ID", "RAZORPAY_TEST_KEY_SECRET",
    "RAZORPAY_TEST_WEBHOOK_SECRET", "RAZORPAY_LIVE_KEY_ID",
    "RAZORPAY_LIVE_KEY_SECRET", "RAZORPAY_LIVE_WEBHOOK_SECRET",
]
content = "".join(f"{key}={values[key]}\n" for key in ordered if key in values)
if preserved_lines:
    content += "\n" + "\n".join(preserved_lines) + "\n"
target.write_text(content, encoding="utf-8")
PY

chmod 600 "$TEMP_FILE"
mv "$TEMP_FILE" "$SECRET_FILE"
chmod 600 "$SECRET_FILE"
echo "Razorpay credentials are mode-isolated and Test Mode remains active."
