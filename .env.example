# Public Vite configuration. The Razorpay key ID is returned by the backend,
# so it does not need to be embedded in the frontend build.
VITE_BRAND_NAME=Vibe4You

# Public Firebase web configuration. These values identify the web app only;
# they are not server credentials. Enable Google and Phone in Firebase Auth.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace_with_firebase_web_app_id

# Server-only values belong in ~/.config/styledash/secrets.env on Termux.
# Never prefix the secret with VITE_ and never commit real credentials.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_TEST_KEY_SECRET=replace_with_test_api_secret
RAZORPAY_TEST_WEBHOOK_SECRET=replace_after_creating_test_webhook
RAZORPAY_LIVE_KEY_ID=rzp_live_replace_only_when_ready
RAZORPAY_LIVE_KEY_SECRET=replace_only_when_ready
RAZORPAY_LIVE_WEBHOOK_SECRET=replace_with_existing_live_webhook_secret
STYLEDASH_SUPPORTED_PINCODES=458441,458442,458001,458002
STYLEDASH_TOTP_ENCRYPTION_KEY=generate_privately_on_the_server
STYLEDASH_DATABASE_PATH=/private/path/to/styledash.db
STYLEDASH_PUBLIC_ORIGIN=https://vibe4you.in
STYLEDASH_ENABLE_TEST_PRODUCT=false
STYLEDASH_TEST_PRODUCT_ALLOWED_EMAILS=owner-account@example.invalid

# Private Firebase Admin verification. Store only in secrets.env, never VITE_*.
STYLEDASH_FIREBASE_PROJECT_ID=your-project-id
STYLEDASH_FIREBASE_CREDENTIALS=/private/path/to/firebase-admin.json

# Private production reliability configuration. Keep real values only in
# ~/.config/styledash/secrets.env on Termux.
STYLEDASH_NTFY_ENABLED=false
STYLEDASH_NTFY_BASE_URL=https://ntfy.sh
STYLEDASH_NTFY_TOPIC=replace-with-private-topic
STYLEDASH_NTFY_BACKGROUND=false
STYLEDASH_BACKUP_REMOTE=styledash-crypt:StyleDash/production
STYLEDASH_REQUIRE_OFFDEVICE_BACKUP=false
STYLEDASH_BACKUP_REMOTE_SECONDARY=
STYLEDASH_RECOVERY_WINDOWS_HOST=
STYLEDASH_RECOVERY_WINDOWS_USER=
STYLEDASH_RECOVERY_WINDOWS_KEY=
STYLEDASH_RECOVERY_WINDOWS_PASSWORD_FILE=
STYLEDASH_RECOVERY_REMOTE_PRIMARY=styledash-crypt:StyleDash/recovery
STYLEDASH_RECOVERY_REMOTE_SECONDARY=windows-backup:StyleDash-Disaster-Recovery/recovery
