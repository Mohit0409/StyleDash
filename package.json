{
  "name": "styledash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "payment:catalog": "node scripts/generate-payment-catalog.mjs",
    "build": "npm run payment:catalog && tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --dir src/tests",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "tsc -b && vite build",
    "test:e2e:desktop": "npm run build:e2e && playwright test --project=desktop-chromium",
    "test:e2e:mobile": "npm run build:e2e && playwright test --project=mobile-chromium",
    "test:payment-api": "vitest run src/tests/paymentApi.test.ts",
    "verify:fast": "node scripts/verify-fast.mjs",
    "verify:full": "npm run verify:fast && npm run test:e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "protobufjs@7.6.5": true
  }
}
